# Copy to .env.local and fill in. Never commit real values.
# Values for local dev are printed by `pnpm supabase start` (or `pnpm supabase status`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. Do NOT prefix with NEXT_PUBLIC_. Only used by specific server code (webhooks, admin).
SUPABASE_SECRET_KEY=replace-with-local-secret-key
