# Copy to .env and fill in. Never commit real values.
# Local Supabase Postgres (printed by `pnpm supabase status` as "DB URL").
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Server-only secret key (never NEXT_PUBLIC_), used later for storage/admin operations from jobs.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=replace-with-local-secret-key

LOG_LEVEL=info
